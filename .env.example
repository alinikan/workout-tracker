# Copy this file to .env.local and fill in the values from Supabase.
# These keys are safe for browser apps when Row Level Security is enabled.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional server-only key for autoplaying WorkoutX exercise GIFs.
# Do not rename this to VITE_WORKOUTX_API_KEY, because VITE_ variables are exposed to browsers.
WORKOUTX_API_KEY=YOUR_WORKOUTX_API_KEY
