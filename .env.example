# Copy this file to .env.local for local development, then fill in the values from Supabase.
# Variables beginning with VITE_ are visible in browser code, so only use browser-safe keys here.
# These Supabase values are safe when Row Level Security is enabled by supabase/schema.sql.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional server-only key for autoplaying WorkoutX exercise GIFs.
# This is read only by api/workoutx-gif.js on Vercel or `vercel dev`.
# Do not rename this to VITE_WORKOUTX_API_KEY, because VITE_ variables are exposed to browsers.
WORKOUTX_API_KEY=YOUR_WORKOUTX_API_KEY
